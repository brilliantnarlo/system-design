        <mxCell id="tjEI-MZ61G11P0g9PuBw-7" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=none;strokeColor=none;fontStyle=0;fontColor=#009999;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Image Assembler Service&lt;/h1&gt;&lt;div&gt;Assemble images accrose multiple notes that can easily sacle horizontally making the system to have a very high avalibility and performance.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;ul data-start=&quot;962&quot; data-end=&quot;1021&quot;&gt;&lt;br&gt;&lt;/ul&gt;" vertex="1">

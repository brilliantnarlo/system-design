        <mxCell id="FLQxsfm0ZKUBVexxL3yo-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;labelBackgroundColor=default;" value="Ingest Service" vertex="1">
          <mxGeometry height="30" width="90" x="532.5" y="340" as="geometry" />
        </mxCell>
        <mxCell id="tjEI-MZ61G11P0g9PuBw-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=none;strokeColor=none;fontStyle=0;fontColor=#999900;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Message Service&lt;/h1&gt;&lt;div&gt;Apache Kafka is a distributed event streaming platform capable of handling trillions of events per day.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;ul data-start=&quot;962&quot; data-end=&quot;1021&quot;&gt;&lt;br&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="110" width="370" x="720" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="tjEI-MZ61G11P0g9PuBw-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;glass=0;fillColor=#999900;strokeColor=#999900;" value="message queue (Kafka)" vertex="1">
